{
    "name": "koolikell",
    "version": "1.1.6",
    "productName": "koolikell",
    "description": "Koolikellade ajakava ja automaatne helistamine Windowsis",
    "main": "dist-electron/main.js",
    "scripts": {
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",

    "server:build": "npm --prefix server run build",

    "electron:build": "tsc -p tsconfig.electron.json",

    "electron": "npm run server:build && concurrently -k --success command \"npm run client\" \"npm run electron:build && electron dist-electron/main.js\"",
    "dist:win": "npm run client:build && npm run server:build && npm run electron:build && electron-builder --win nsis"
},

    "build": {
        "appId": "ee.koolikell.app",
        "productName": "koolikell",
        "compression": "maximum",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist-electron/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "client/dist",
                "to": "client/dist"
            },
            {
                "from": "server/dist",
                "to": "server/dist"
            },
            {
                "from": "server/node_modules",
                "to": "server/node_modules",
                "filter": [
                    "**/*",
                    "!prisma/**",
                    "!typescript/**",
                    "!ts-node/**",
                    "!ts-node-dev/**",
                    "!tsx/**",
                    "!@types/**",
                    "!@esbuild/**",
                    "!@prisma/studio-core/**",
                    "!@prisma/dev/**",
                    "!@prisma/query-plan-executor/**",
                    "!@prisma/fetch-engine/**",
                    "!**/*.map",
                    "!**/*.md",
                    "!**/test/**",
                    "!**/tests/**",
                    "!**/__tests__/**"
                    ,"!**/*.pdb"
                    ,"!**/*.iobj"
                    ,"!**/*.ipdb"
                    ,"!**/better-sqlite3/build/obj/**"
                    ,"!**/better-sqlite3/deps/**"
                    ,"!**/better-sqlite3/prebuilds/linux-*/**"
                    ,"!**/better-sqlite3/prebuilds/darwin-*/**"
                ]
            },
            {
                "from": "server/prisma",
                "to": "server/prisma"
            },
            {
                "from": "build/icon.ico",
                "to": "build/icon.ico"
            }
        ],
        "win": {
            "target": "nsis",
            "icon": "build/icon.ico",
            "signExecutable": false
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "koolikell",
            "include": "build/uninstaller.nsh"
        }
    },

    "devDependencies": {
        "concurrently": "^9.2.1",
        "electron": "^44.5.1",
        "electron-builder": "^26.15.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}