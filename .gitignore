# Dependencies
**/node_modules/

# Environment files and secrets
**/.env
**/.env.*
!**/.env.example

# Local SQLite databases
**/*.db
**/*.db-journal
**/*.db-shm
**/*.db-wal

# Build and coverage output
**/dist/
**/build/
**/coverage/
/dist-electron/
/release/
*.blockmap

# Runtime-uploaded sound files
/server/sounds/*
!/server/sounds/.gitkeep
/server/playnow/*
!/server/playnow/.gitkeep

# Keep the Windows installer icon under version control
!/build/
/build/*
!/build/icon.ico

# Logs and temporary files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
*.tmp

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
