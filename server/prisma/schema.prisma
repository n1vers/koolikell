generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}
model Profile {
  id        Int        @id @default(autoincrement())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  schedules Schedule[]
}

model Schedule {
    id             Int      @id @default(autoincrement())
    profileId      Int

    dayOfWeek      Int
    time           String

    type           String

    enabled        Boolean  @default(true)
    preBellEnabled Boolean  @default(true)

    soundId        Int?
    preBellSoundId Int?

    profile Profile @relation(fields: [profileId], references: [id])
    sound   Sound?  @relation(fields: [soundId], references: [id])
    preBellSound Sound? @relation("PreBellSound", fields: [preBellSoundId], references: [id])
}

model Sound {
  id        Int        @id @default(autoincrement())
  name      String
  fileName  String
  createdAt DateTime   @default(now())

  schedules Schedule[]
  preBellSchedules Schedule[] @relation("PreBellSound")
}